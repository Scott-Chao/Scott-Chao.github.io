---
import { skills } from '../../data/skills';

interface Props {
  number: string;
}

const { number } = Astro.props;
---

{skills.length > 0 && (
  <section class="section-row" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-label">
      <span class="section-number" aria-hidden="true">
        {number}
      </span>
      <span class="section-title">Technical Skills</span>
    </h2>
    <dl class="skills-list">
      {skills.map((group) => (
        <div class="skill-group">
          <dt>{group.category}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .skills-list {
    font-size: 15px;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 208px minmax(0, 1fr);
    gap: var(--space-6);
  }

  .skill-group + .skill-group {
    margin-top: var(--space-3);
  }

  dt {
    font-weight: 500;
  }

  dd {
    color: var(--color-muted);
  }

  @media (max-width: 639px) {
    .skill-group {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .skill-group + .skill-group {
      margin-top: var(--space-4);
    }
  }
</style>
